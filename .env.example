# Cliente (públicas, se incluyen en el bundle)
EXPO_PUBLIC_API_URL=https://pacta-theta.vercel.app
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Servidor (solo en Vercel)
SUPABASE_SERVICE_ROLE_KEY=
# Rol pacta_app (solo esquema pacta), pooler de Supabase, puerto 6543
DATABASE_URL=
WHOP_API_KEY=
WHOP_APP_ID=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=
WHOP_STAKE_PRODUCT_ID=
# High-Yield Pass: producto de Whop (prod_QdKfivmFTDf6L); el plan de $9/30 días se crea al vuelo
WHOP_PASS_PRODUCT_ID=
WHOP_PASS_PLAN_ID=
# Iframe de Whop: el mismo app_… en el servidor (audiencia del token) y en el cliente (modal de pago)
EXPO_PUBLIC_WHOP_APP_ID=
# Login público Whop con PKCE: npm run whop:auth registra los callbacks en la app existente.
# Callbacks extra (p. ej. previews), separados por comas, con coincidencia exacta.
WHOP_OAUTH_REDIRECT_URIS=
# Opcional solo si se usa otra app OAuth de tipo confidential. PACTA usa public + PKCE.
WHOP_CLIENT_SECRET=
# Solo pruebas locales de API; ignorado en Vercel/production. La UI siempre exige login.
ALLOW_DEMO_USER=false
PUBLIC_APP_URL=https://pacta-theta.vercel.app
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TERAC_MCP_URL=
TERAC_API_KEY=
TERAC_WEBHOOK_SECRET=
# Estudio permanente de Terac que atiende los casos del jurado (id de la opportunity)
TERAC_JURY_OPPORTUNITY_ID=
# Agente auditor: versión del prompt (pacta.agent_prompts) y modelo (gemini-* usa Google; el resto, Anthropic)
AGENT_PROMPT_VERSION=v1-baseline
AGENT_MODEL=gemini-3.6-flash
DEMO_USER_ID=
# Estudio de Terac de la ronda 1 de calibración (set de evaluación)
TERAC_ROUND1_OPPORTUNITY_ID=
# Revisión humana: stake mínimo en céntimos para que la duda de la IA llegue a Terac (prod: 3000-4000)
HUMAN_REVIEW_MIN_STAKE_CENTS=2000
# Demo: permite apelar sin High-Yield Pass (hasta que el pago llegue con Whop)
FREE_APPEALS=false
